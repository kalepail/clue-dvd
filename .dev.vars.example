# Local Cloudflare AI Gateway / Workers AI credentials. Copy this file to
# .dev.vars and provide real values; .dev.vars is ignored and must not be committed.
CLOUDFLARE_ACCOUNT_ID=your-account-id
AI_GATEWAY_ID=default
AI_GATEWAY_TOKEN=your-account-api-token

# Direct Anthropic is used when Cloudflare transports are unavailable or fail.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional runtime overrides. The default remains Claude Opus 4.8.
AI_MYSTERY_MODEL=anthropic/claude-opus-4.8
AI_MYSTERY_REASONING_EFFORT=medium

# Configurable catalog (account/model availability is not implied):
# anthropic/claude-opus-4.8, anthropic/claude-sonnet-5
# openai/gpt-5.6-luna, openai/gpt-5.6-terra, openai/gpt-5.6-sol, openai/gpt-5.4
# xai/grok-4.3
# @cf/openai/gpt-oss-120b, @cf/moonshotai/kimi-k2.6
# @cf/meta/llama-3.3-70b-instruct-fp8-fast, @cf/qwen/qwen3-30b-a3b-fp8
